# Used by Docker Compose. Set your own password for a hosted deployment.
POSTGRES_PASSWORD=lootradar_local_only
# Optional Google OAuth web client (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Match the browser origin and register its /login/oauth2/code/google callback.
# APP_BASE_URL=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false
